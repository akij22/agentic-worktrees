# Public GitHub App identifier embedded in the main-process bundle.
GITHUB_CLIENT_ID=

# Public GitHub App slug used to open installation and authorization pages.
GITHUB_APP_SLUG=

# Local workspace root where repository clones and worktrees live.
WORKTREEHUB_WORKSPACE_ROOT=

# Persistent 32-byte hex key for Worktree Resource evidence. Keep it stable across restarts.
# Resource cutover stays unavailable without this key; it is never sent to providers or renderer.
WORKTREEHUB_RESOURCE_EVIDENCE_KEY=
WORKTREEHUB_RESOURCE_EVIDENCE_KEY_VERSION=1
# Optional JSON object of previous version numbers to 32-byte hex keys for retained evidence.
WORKTREEHUB_RESOURCE_EVIDENCE_PREVIOUS_KEYS=

# Required for npm run smoke:capabilities: packaged Agentic Worktrees executable.
AW_SMOKE_EXECUTABLE=

# Optional: raises Exa limits for npm run smoke:capabilities.
# The desktop app stores user-provided capability keys in Electron safeStorage.
EXA_API_KEY=
