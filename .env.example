# Public GitHub App identifier embedded in the main-process bundle.
GITHUB_CLIENT_ID=

# Public GitHub App slug used to open installation and authorization pages.
GITHUB_APP_SLUG=

# Local workspace root where repository clones and worktrees live.
WORKTREEHUB_WORKSPACE_ROOT=

# Required for npm run smoke:capabilities: packaged Agentic Worktrees executable.
AW_SMOKE_EXECUTABLE=

# Optional: raises Exa limits for npm run smoke:capabilities.
# The desktop app stores user-provided capability keys in Electron safeStorage.
EXA_API_KEY=
